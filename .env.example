# Скопируйте в .env и заполните. .env в .gitignore.
# Нужен только для `locqa check --llm`.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель (по умолчанию gemini-2.5-flash)
LOCQA_LLM_MODEL=gemini-2.5-flash

# 1 = бесплатный тариф AI Studio: billed_usd = 0 в cost.json
LOCQA_FREE_TIER=0

# Ограничение запросов в минуту (0 = без ограничения) и строк в одном запросе
LOCQA_LLM_RPM=0
LOCQA_LLM_BATCH=20

# Тарифы для модели, которой нет в src/locqa/llm/cost.py (USD за 1M токенов)
# LOCQA_PRICE_INPUT=
# LOCQA_PRICE_OUTPUT=
